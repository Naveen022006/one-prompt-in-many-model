# Copy to .env in the project root. Both backend and frontend read it.

# ---- Supabase (backend) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key

# ---- Supabase + API URL (frontend, exposed to the browser) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_API_URL=http://localhost:8000

# ---- Usage limits (optional) ----
# DAILY_MESSAGE_LIMIT=50        # messages per user per day (UTC)
# MESSAGES_PER_MINUTE=10
# MAX_CONCURRENT_STREAMS=2
# MAX_PROMPT_CHARS=8000
# MAX_AGENTS_PER_MESSAGE=3

# ---- Context window and generation (optional) ----
# CONTEXT_TOKEN_BUDGET=12000    # estimated tokens of past chat sent to each agent
# MAX_OUTPUT_TOKENS=2048
# REQUEST_TIMEOUT_SECONDS=90
# SYSTEM_PROMPT="You are a helpful assistant..."

# ---- Model IDs (optional; change when providers release or retire models) ----
# OPENAI_MODEL=gpt-5.4-mini
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=llama-3.3-70b-versatile
# CLAUDE_MODEL=claude-haiku-4-5
# DEEPSEEK_MODEL=deepseek-chat
# GROK_MODEL=grok-4.3
